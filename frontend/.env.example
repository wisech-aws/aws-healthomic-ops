# Frontend runtime configuration (Vite).
#
# Copy this file to one of:
#   .env.development  — used by `scripts/dev-local.sh` / `vite` in dev mode
#   .env.production   — used by `vite build`
# and fill in the values from your deployed stack's CDK outputs
# (see cdk-outputs.json / scripts/inject-config.mjs). Do NOT commit the
# filled-in .env.* files; only this .env.example template is tracked.

# When true, the GraphQL client serves in-memory sample data and no-op
# subscriptions instead of calling AppSync — the UI runs with no deployed
# backend and no Cognito sign-in. Set to false to connect to real AWS.
VITE_LOCAL_MOCK=true

# AppSync GraphQL endpoint (HealthOmicsApi -> GraphqlApiUrl).
VITE_APPSYNC_ENDPOINT=https://<your-api-id>.appsync-api.<region>.amazonaws.com/graphql

# Cognito user pool that fronts the API (HealthOmicsApi -> UserPoolId).
VITE_USER_POOL_ID=<region>_xxxxxxxxx

# Cognito SPA app client id (HealthOmicsApi -> UserPoolClientId).
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS region the backend is deployed in.
VITE_AWS_REGION=us-east-1
