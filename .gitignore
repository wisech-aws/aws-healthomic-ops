# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# CDK
infra/cdk.out/
cdk.out/

# Git worktrees (local scratch checkouts, not source)
.worktrees/

# Compiled CDK output committed alongside TS sources (CDK runs via ts-node).
# Scoped to lib/ and bin/ ONLY — infra/resolvers/*.js are hand-written AppSync
# resolvers (real source) and must stay tracked.
infra/lib/*.js
infra/lib/*.d.ts
# Compiled test output (generated by tsc/jest; never source).
infra/test/*.js
infra/test/*.d.ts
infra/bin/*.js
infra/bin/*.d.ts

# Agent/workflow planning artifacts (dev scaffolding, not product).
.agents/

# Test / coverage
coverage/

# Logs
*.log
build.log

# Env / local config
.env
.env.*
# ...but keep the committed example template trackable.
!.env.example
!**/.env.example
frontend/src/config.generated.ts
frontend/public/config.generated.js

# OS / editor
.DS_Store
*.swp

# CDK deployment outputs (contains AWS resource identifiers)
cdk-outputs.json

# Downloaded reference artifacts (not source)
*.zip
User Guide*AWS HealthOmics*.html

# HealthOmics run-parameter scratch files (generated when starting runs)
params-*.json

# Kiro specs / AI agent prompt docs (not part of the open-source project)
.kiro/
*Coding Agent Prompt*.md
