{
  "name": "healthomics-cost-estimator",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone AWS HealthOmics per-run workflow cost estimator (APIs only; no DynamoDB, no UI).",
  "type": "module",
  "bin": {
    "estimate-run-cost": "estimate-run-cost.mjs"
  },
  "scripts": {
    "estimate": "node estimate-run-cost.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-omics": "3.1119.0",
    "@aws-sdk/client-pricing": "3.1119.0",
    "@aws-sdk/credential-provider-node": "3.972.81",
    "@smithy/signature-v4": "5.7.3"
  }
}
